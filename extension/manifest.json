{
  "manifest_version": 3,
  "name": "OTP Bridge \u2014 Login helper",
  "version": "0.5.0",
  "minimum_chrome_version": "124",
  "description": "New phone codes and email sign-in links appear automatically. Copy, fill or open only when you choose.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "clipboardWrite",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open OTP inbox",
    "default_popup": "launcher.html"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "optional_permissions": [
    "notifications"
  ],
  "icons": {
    "48": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open OTP inbox"
    }
  }
}
